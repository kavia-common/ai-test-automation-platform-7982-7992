# Frontend environment example for local development

# Base URL of the backend API (recommended)
REACT_APP_API_BASE=http://localhost:3001

# Optional: Alternate var name that is also supported by the client
# REACT_APP_BACKEND_URL=http://localhost:3001

# Optional: Health check path (defaults to '/')
REACT_APP_HEALTHCHECK_PATH=/

# Optional: Port for the React dev server (CRA uses PORT)
# PORT=3000

# Other optional variables referenced by Settings page (not required)
# REACT_APP_FRONTEND_URL=http://localhost:3000
# REACT_APP_WS_URL=ws://localhost:3001
# REACT_APP_NODE_ENV=development
# REACT_APP_ENABLE_SOURCE_MAPS=true
# REACT_APP_PORT=3000
# REACT_APP_TRUST_PROXY=false
# REACT_APP_LOG_LEVEL=info
# REACT_APP_FEATURE_FLAGS=
# REACT_APP_EXPERIMENTS_ENABLED=false
