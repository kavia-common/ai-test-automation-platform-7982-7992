# Example environment variables for React frontend
# Copy this file to .env and adjust values as needed

# Backend API base URL (preferred)
REACT_APP_API_BASE=http://localhost:3001

# Alternative variable name supported for base URL resolution
REACT_APP_BACKEND_URL=http://localhost:3001

# Health check path on backend
REACT_APP_HEALTHCHECK_PATH=/

# Frontend port (used by dev server; may be set by tooling)
REACT_APP_PORT=3000

# Optional: other app env vars referenced by Settings page
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=development
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
